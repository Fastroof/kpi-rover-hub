#!/usr/bin/env bash
# Fresh ros_sw and kpi_rover_gui in ~/work. Usage: kpi-setup [ros_sw branch]
# An existing ros_sw is kept as ros_sw.<date>.
set -eo pipefail
branch="${1:-${ROS_SW_BRANCH}}"
cd ~/work

if [[ -e ros_sw ]]; then
  mv ros_sw "ros_sw.$(date +%Y%m%d-%H%M%S)"
fi
git clone -b "${branch}" "${ROS_SW_REPO}" ros_sw
cd ros_sw
vcs import src < deps.repos
source /opt/ros/jazzy/setup.bash
colcon build

[[ -d ~/work/kpi_rover_gui ]] || git clone "${GUI_REPO}" ~/work/kpi_rover_gui
echo "kpi-setup: done (ros_sw branch ${branch})"
